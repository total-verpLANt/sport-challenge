# REQUIRED: App startet nicht ohne diesen Key (mind. 32 zufällige Zeichen in Produktion)
SECRET_KEY=aendere-mich-in-produktion

# Strava OAuth (optional – ohne diese Var verschwindet Strava aus der UI)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Docker / Deployment
# Upload-Verzeichnis (Standard: app/static/uploads relativ zum Projektroot)
# In Docker: UPLOAD_FOLDER=/app/app/static/uploads (oder per Volume-Mount leer lassen)
UPLOAD_FOLDER=

# WSGI-Server: Anzahl Gunicorn-Worker
# ACHTUNG: Wert > 1 macht Rate-Limits pro Worker statt global (In-Memory-Limiter)!
GUNICORN_WORKERS=1

# Flask CLI (für flask db upgrade im Container-Entrypoint)
FLASK_APP=run.py

# Host-Header-Härtung (Produktion – siehe Issue haf)
# Kanonische Basis-URL für Mail-/OAuth-Links; verhindert Host-Header-Poisoning.
# Ohne diese Var werden externe Links aus dem Request-Host abgeleitet (nur für lokale Dev ok).
PUBLIC_BASE_URL=https://example.com
# Allowlist erlaubter Host-Header (komma-getrennt); Flask weist fremde Hosts mit HTTP 400 ab.
TRUSTED_HOSTS=example.com
# X-Forwarded-Host nur vertrauen (1), wenn der vorgelagerte Proxy ihn garantiert setzt – sonst 0.
PROXY_X_HOST=0

# Mailgun E-Mail-Versand (optional – App startet ohne diese Vars, Mailversand schlägt dann fehl)
# EU-Region: MAILGUN_BASE_URL=https://api.eu.mailgun.net/v3
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_SENDER=Sport Challenge <noreply@mg.example.com>
MAILGUN_BASE_URL=https://api.mailgun.net/v3
